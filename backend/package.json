{
  "name": "@bis/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:snapshot": "tsx scripts/export-sample-data.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/db/create-admin-cli.ts",
    "restore": "tsx --env-file-if-exists=.env src/db/restore-cli.ts"
  },
  "dependencies": {
    "@bis/scoring": "workspace:*",
    "@bis/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.4",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.0",
    "fake-indexeddb": "^6.2.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
