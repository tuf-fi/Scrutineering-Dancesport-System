# Copy to .env. Everything has a default for local development.
PORT=4000
# 0.0.0.0 lets phones and laptops on the venue Wi-Fi reach the server
HOST=0.0.0.0
DATABASE_PATH=./data/bis.db
# Signs sign-in cookies. Leave it out and the server makes a random one beside the database on first start
# COOKIE_SECRET=
# Comma-separated folders that receive a copy of the database, e.g. a USB drive and Laptop 3's shared folder
BACKUP_DIRS=./data/backups
BACKUP_INTERVAL_MINUTES=5
# The built frontend this server also serves; leave empty to turn it off
FRONTEND_DIR=../frontend/dist
# HTTPS: phones only keep an offline copy of the app over HTTPS. Both files are made once for the laptop's address (see VENUE.md)
# TLS_CERT=./certs/bis.crt
# TLS_KEY=./certs/bis.key
