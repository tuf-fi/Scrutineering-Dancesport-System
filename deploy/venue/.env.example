# The venue laptop. Copy to .env in this folder.

# Required: the same DATA_KEY as the online server's deploy/.env
DATA_KEY=

# An adjudicator's PIN works this many days either side of the competition date. Use "off" only to rehearse with a past competition
ADJUDICATOR_PIN_DAYS=1

# The port phones use. 80 means they type just the laptop's address; change it only if something else on the laptop uses port 80
VENUE_PORT=80

# A folder on the USB drive that gets a copy of every change, for example E:/bis-backup on Windows. Leave it to use ./usb-backup
# USB_BACKUP=E:/bis-backup
