# Staging: a separate server from production, with its own database. Copy to deploy/.env on the staging server.
# Use fake clubs and athletes only, and never real payment keys.

# The staging address, with DNS already pointing at the staging server
DOMAIN=staging.bis.example.com

# Leave empty to let the server make and keep its own
COOKIE_SECRET=

# "off" lets PINs work on any day, so a past or future competition can be practised
ADJUDICATOR_PIN_DAYS=off

PUBLIC_RATE_LIMIT=600

# Off-site copy is not needed for staging
OFFSITE_REMOTE=
