# The address people will use, with DNS already pointing at this server
DOMAIN=bis.example.com

# One secret per venue laptop, at least 16 characters each: venue=secret,venue=secret
# Make them with:  openssl rand -hex 24
SYNC_TOKENS=

# Leave empty to let the server make and keep its own
COOKIE_SECRET=

# Messages to clubs on Facebook Messenger (see README). Leave empty to turn them off.
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_USERNAME=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
