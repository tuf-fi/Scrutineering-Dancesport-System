# The address people will use, with DNS already pointing at this server
DOMAIN=bis.example.com

# Leave empty to let the server make and keep its own
COOKIE_SECRET=

# Encrypts authenticator secrets in the database. Required: 32 or more random characters, for example from
#   openssl rand -hex 32
# Keep a copy somewhere safe, outside the server. If it is lost, staff set up two-step sign-in again.
DATA_KEY=

# An adjudicator's PIN works this many days either side of the competition's date. 1 is right for a one-day event;
# use "off" only to practise with a past competition.
ADJUDICATOR_PIN_DAYS=1

# Email, for confirming new accounts and for forgot password. Leave BREVO_API_KEY empty to send nothing: new accounts
# then need no confirmation and forgot password prints its link in the server log instead.
# Brevo (brevo.com) is free for 300 emails a day with no card. Make an account, add your sending address or domain under
# Senders, domains and dedicated IPs, add the SPF and DKIM records it shows to your DNS, then create an API key (SMTP and API).
BREVO_API_KEY=
# The sender shown to people, an address Brevo has verified, such as: BOSS <no-reply@bis.example.com>
MAIL_FROM=
# Where the links in the emails point. Leave empty to use https://DOMAIN
PUBLIC_URL=

# Requests a minute from one address for calls that need no sign-in, such as the public pages. "off" turns it off.
PUBLIC_RATE_LIMIT=600

# Daily copy of the backups to another place (see README, Backups). Leave empty to turn it off.
# OFFSITE_REMOTE is a rclone destination such as "offsite:bis-backups". Describe "offsite" with RCLONE_CONFIG_OFFSITE_*
# settings, for example for Backblaze B2 or any S3 storage:
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://...
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
OFFSITE_REMOTE=

